# ==============================================================================
# OpenKB Environment Configuration
# ==============================================================================
# NOTE: This file manages your API KEYS. 
# The ACTUAL MODEL used is defined in your KB's config file:
#   - Local KB: <kb_dir>/.openkb/config.yaml -> model: "provider/model"
#   - Global Default: ~/.config/openkb/config.yaml
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Unified API Key (Recommended)
# ------------------------------------------------------------------------------
# Set this single key, and OpenKB will automatically propagate it to all 
# supported providers (OpenAI, Anthropic, DeepSeek, etc.). 
# This is perfect for single-provider setups or when using an API aggregator.
LLM_API_KEY=your-key-here

# ------------------------------------------------------------------------------
# OPTION 2: Provider-Specific API Keys
# ------------------------------------------------------------------------------
# You can also set keys for specific providers. These take PRECEDENCE over 
# LLM_API_KEY if both are provided for the same provider.

# OpenAI / OpenAI-Compatible (e.g., DeepSeek, Groq, etc.)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=

# Chinese Providers (Kimi, Zhipu, Qwen)
MOONSHOT_API_KEY=   # or KIMI_API_KEY
ZHIPUAI_API_KEY=    # or GLM_API_KEY
DASHSCOPE_API_KEY=  # or QWEN_API_KEY

# ------------------------------------------------------------------------------
# PageIndex Cloud (Optional)
# ------------------------------------------------------------------------------
# Required only if you are using PageIndex Cloud for document processing
PAGEINDEX_API_KEY=
